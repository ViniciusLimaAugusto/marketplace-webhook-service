{
  "name": "marketplace-webhook-service",
  "version": "0.1.0",
  "private": true,
  "description": "Backend service for receiving and processing synthetic marketplace events.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/api/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/api/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "db:check": "node --env-file-if-exists=.env src/infrastructure/database/command.ts check",
    "db:migrate": "node --env-file-if-exists=.env src/infrastructure/database/command.ts up",
    "db:rollback": "node --env-file-if-exists=.env src/infrastructure/database/command.ts down",
    "db:migration:create": "node src/infrastructure/database/command.ts create",
    "test:integration": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "fastify": "^5.12.8",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.4",
    "@types/pg": "^8.23.1",
    "eslint": "^10.16.0",
    "eslint-config-prettier": "^10.1.9",
    "prettier": "^3.10.1",
    "typescript": "5.9",
    "typescript-eslint": "^8.74.0",
    "vitest": "^4.1.12"
  }
}
