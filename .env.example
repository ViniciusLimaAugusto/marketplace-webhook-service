NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

# Replace both CHANGE_ME placeholders with URL-encoded local passwords.
DATABASE_URL=postgresql://marketplace_app:CHANGE_ME@localhost:5432/marketplace_webhook_service
TEST_DATABASE_URL=postgresql://marketplace_test:CHANGE_ME@localhost:5432/marketplace_webhook_service_test

DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
